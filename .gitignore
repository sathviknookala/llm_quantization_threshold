# Model checkpoints and derived quantized artifacts (tens of GB)
checkpoints/
models/

# Raw logits tensors: large, binary, and regenerable from scripts/ at a fixed seed.
# The tracked JSON summaries carry the numbers and the context identity checks.
*.npy

# OS / editor cruft
.DS_Store
__pycache__/
*.pyc

# Pilot corpus bodies (token IDs, regenerable at a fixed seed) and gate logits.
# The tracked manifests carry the hashes that make a run reproducible.
results/pilot/corpus/*.json
!results/pilot/corpus/*_manifest.json
results/pilot/gate_logits/
results/pilot/server_logs/

# Sweep engine logs: large, per-launch, and the cell records carry the launch identity
# (kv_cache_tokens, dispatch_verdict) that actually matters for reproduction.
results/sweep/server_logs/

# Live-run scratch: PID of the detached completion chain.
results/sweep/followup.pid

# Quality arm. Full-vocab distribution shards and engine logs are large and regenerable from the
# frozen trajectories; the tracked manifests, gate artifacts and raw KL cells carry the identity.
results/quality/**/dist/
results/quality/**/logs/
results/quality/checkpoint_hashes.json
